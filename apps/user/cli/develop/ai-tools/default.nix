{
  lib,
  pkgs,
  config,
  user,
  ...
}:
let
  inherit (config.lib.ndchm.chezmoi) importChezmoiUserAppData getChezmoiFilePath;
  appData = importChezmoiUserAppData user;
  inherit (appData) mcp opencode omo;
  # codebase-memory-mcp has no env/flag for these; they are written to
  # ${CBM_CACHE_DIR}/_config.db via `config set` (see chezmoiscripts too).
  cbmSettings = appData.codebaseMemory or { };
  # Nix's toString renders booleans as "1"/""; the CLI expects "true"/"false".
  cbmSettingValue =
    value: if builtins.isBool value then (if value then "true" else "false") else toString value;
  inherit (builtins) toJSON;
  inherit (lib)
    escapeShellArg
    filterAttrs
    getExe
    getExe'
    last
    mapAttrs
    splitString
    ;
  envFile = "${config.home.homeDirectory}/.env";
  # ~/.env is generated by sops-nix as plain KEY=VALUE lines, not a shell
  # script. Parse it instead of sourcing it so values with spaces or special
  # characters are exported verbatim.
  loadEnv = ''
    if [ -r ${escapeShellArg envFile} ]; then
      while IFS='=' read -r key value; do
        case "$key" in
          "" | '#'*) continue ;;
        esac
        export "$key=$value"
      done < ${escapeShellArg envFile}
    fi
  '';
in
{
  home = {
    packages =
      with pkgs;
      let
        wrapExe =
          p:
          let
            exeName = last (splitString "/" (getExe p));
          in
          #NOTE: API keys are secret, so I don't export to global env
          writeShellScriptBin "${exeName}" ''
            ${loadEnv}
            export SSL_CERT_DIR="${pkgs.cacert}/etc/ssl/certs"
            exec ${getExe' p exeName} "$@"
          '';
        oh-my-openagent' = pkgs.symlinkJoin {
          inherit (pkgs.oh-my-openagent) meta;
          name = "${lib.getName pkgs.oh-my-openagent}-wrapped-${lib.getVersion pkgs.oh-my-openagent}";
          paths = [ pkgs.oh-my-openagent ];
          preferLocalBuild = true;
          nativeBuildInputs = [ pkgs.makeWrapper ];
          postBuild = ''
            wrapProgram $out/bin/${pkgs.oh-my-openagent.meta.mainProgram} \
              --suffix PATH : ${lib.makeBinPath config.programs.opencode.extraPackages} \
          '';
        };
      in
      (map wrapExe [
        mcp-hub
        oh-my-openagent'
      ])
      ++ [
        (writeShellScriptBin "copilot-oc" ''
          ${loadEnv}
          export COPILOT_PROVIDER_API_KEY="$OPENCODE_API_KEY"
          export COPILOT_PROVIDER_TYPE=openai
          export COPILOT_PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
          export COPILOT_MODEL=deepseek-v4-flash
          exec ${pkgs.github-copilot-cli}/bin/copilot "$@"
        '')
        # mcp servers
        context7-mcp
        github-mcp-server
        mcp-nixos
        mcp-server-git
        mcpvault
        paper-search-mcp
        codebase-memory-mcp
      ];
    file = {
      ".copilot/mcp-config.json".text = toJSON {
        mcpServers = mapAttrs (
          _: x:
          {
            type = "local";
            tools = [ "*" ];
            args = [ ];
          }
          // x
        ) (filterAttrs (k: _: k != "github-mcp-server") mcp.mcpServers);
      };
      ".omo/omo.jsonc".text = toJSON omo.settings;
      ".omo/agent/settings.jsonc" = {
        force = true;
        text = toJSON omo.agent.settings;
      };
    }
    // lib.optionalAttrs (omo.agent.models != { }) {
      # omo native (senpi) reads providers from its own models.json, not opencode.json
      ".omo/agent/models.json" = {
        force = true;
        text = toJSON omo.agent.models;
      };
    };
  }
  // lib.optionalAttrs (cbmSettings != { }) {
    activation.codebaseMemorySettings = lib.hm.dag.entryAfter [ "writeBoundary" ] (
      lib.concatStringsSep "\n" (
        lib.mapAttrsToList (
          key: value:
          "${getExe pkgs.codebase-memory-mcp} config set ${key} ${lib.escapeShellArg (cbmSettingValue value)} || "
          + "echo 'codebase-memory: failed to set ${key}; a running daemon may be a different build' >&2"
        ) cbmSettings
      )
    );
  };
  xdg.configFile = {
    "mcphub/servers.json".text = toJSON mcp;
    "opencode/dcp.jsonc".source = getChezmoiFilePath "dot_config/opencode/dcp.jsonc";
    "opencode/plugins/cbm-augment.ts".source =
      pkgs.replaceVars ./codebase-memory-mcp/plugins/cbm-augment.ts
        {
          inherit (pkgs) codebase-memory-mcp;
        };
  };
  programs = {
    mcp = {
      enable = true;
      servers = mcp.mcpServers;
    };
    opencode = {
      enable = true;
      extraPackages = with pkgs; [ uv ];
      package = pkgs.writeShellScriptBin "opencode" ''
        ${loadEnv}
        export OPENCODE_ENABLE_EXA=1
        exec ${pkgs.opencode}/bin/opencode "$@"
      '';
      enableMcpIntegration = true;
      settings = opencode;
      agents = {
        codebase-memory-auditor = ./codebase-memory-mcp/agents/codebase-memory-auditor.md;
        codebase-memory-scout = ./codebase-memory-mcp/agents/codebase-memory-scout.md;
        codebase-memory = ./codebase-memory-mcp/agents/codebase-memory.md;
      };
      skills = {
        codebase-memory-mcp = ./codebase-memory-mcp;
      }
      // pkgs.agent-skills.github.imbad0202.academic-research-skills
      // pkgs.agent-skills.github.coji.natural-japanese;
    };
    github-copilot-cli = {
      enable = true;
    };
  };
}
